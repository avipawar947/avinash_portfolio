# MongoDB (Atlas free tier connection string)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/avinash-portfolio

# Admin auth (single-admin CMS)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-string

# Cloudinary (free tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: upload folder + size limits (defaults: 10 MB images, 15 MB PDFs)
# CLOUDINARY_FOLDER=avinash-portfolio
# CLOUDINARY_MAX_IMAGE_MB=10
# CLOUDINARY_MAX_PDF_MB=15

# Public site URL (used for revalidation / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
